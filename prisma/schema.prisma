generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum PropertyStatus {
  OCCUPIED
  VACANT
  INACTIVE
}

enum PaymentType {
  ADVANCE
  ARREARS
}

enum GuaranteeType {
  CAUTION
  BOOZ
  LOFT
  INSURANCE
}

enum IptuResponsibility {
  OWNER
  TENANT
}

enum CemigHolder {
  TENANT
  OWNER
  THIRD_PARTY
}

enum AdministrationFeeType {
  COMMON_RENTAL_10
  SEASONAL_20
}

enum IntermediationFeeType {
  EXEMPT
  FIFTY_AFTER_THREE_MONTHS
}

enum ContractStatus {
  ACTIVE
  VACANT
  CLOSED
}

enum ContractLifecycleStatus {
  NORMAL
  EXPIRING
  RENEWED
  MOVING_OUT
}

enum ObligationStatus {
  NOT_APPLICABLE
  PENDING
  COMPLETED
}

enum TransferStatus {
  NOT_APPLICABLE
  PENDING
  COMPLETED
}

enum ChargeStatus {
  NONE
  D5
  D7
  D10
  D15
  D20
  D30
  MANUAL_DECISION
  RESOLVED
}

enum ProofType {
  RENT
  WATER
  ENERGY
  IPTU
  DISCOUNT
  OTHER
}

enum ProofAnalysisStatus {
  NOT_ANALYZED
  APPROVED
  NEEDS_REVIEW
  REJECTED
}

enum ChargeStage {
  D5
  D7
  D10
  D15
  D20
  D30
  MANUAL_DECISION
}

enum ChargeRecordStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum TransferRecordStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum DiscountType {
  REPAIR
  BILL
  OTHER
}

enum DiscountStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DiscountInstallmentStatus {
  PENDING
  APPLIED
  CANCELLED
}

enum IptuType {
  SINGLE
  INSTALLMENT
}

enum IptuStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum IptuInstallmentStatus {
  PENDING
  PAID
  CANCELLED
}

enum UtilityStatus {
  NOT_APPLICABLE
  PENDING
  COMPLETED
}

enum AnnualReportStatus {
  NOT_GENERATED
  GENERATED
  SENT
}

model User {
  id    String   @id @default(cuid())
  name  String
  email String   @unique
  role  UserRole @default(OPERATOR)

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Owner {
  id       String  @id @default(cuid())
  name     String
  phone    String?
  email    String?
  document String?
  notes    String?

  properties    Property[]
  contracts     Contract[]
  transfers     Transfer[]
  annualReports AnnualReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tenant {
  id       String  @id @default(cuid())
  name     String
  phone    String?
  email    String?
  document String?
  notes    String?

  contracts Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id      String @id @default(cuid())
  ownerId String

  title   String
  address String
  city    String?
  state   String?
  status  PropertyStatus @default(VACANT)
  notes   String?

  owner Owner @relation(fields: [ownerId], references: [id])

  contracts     Contract[]
  iptuRecords   IptuRecord[]
  annualReports AnnualReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

model Contract {
  id         String @id @default(cuid())
  ownerId    String
  tenantId   String
  propertyId String

  rentAmount Decimal  @db.Decimal(12, 2)
  startDate  DateTime
  endDate    DateTime
  dueDay     Int

  paymentType        PaymentType        @default(ADVANCE)
  guaranteeType      GuaranteeType      @default(CAUTION)
  iptuResponsibility IptuResponsibility @default(OWNER)
  cemigHolder        CemigHolder        @default(TENANT)

  administrationFeeType    AdministrationFeeType @default(COMMON_RENTAL_10)
  administrationFeePercent Decimal               @default(10) @db.Decimal(5, 2)
  intermediationFeeType    IntermediationFeeType @default(EXEMPT)
  intermediationFeePercent Decimal               @default(0) @db.Decimal(5, 2)

  status          ContractStatus          @default(ACTIVE)
  lifecycleStatus ContractLifecycleStatus @default(NORMAL)
  notes           String?

  owner    Owner    @relation(fields: [ownerId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  monthlyObligations   MonthlyObligation[]
  paymentProofs        PaymentProof[]
  charges              Charge[]
  transfers            Transfer[]
  discounts            Discount[]
  discountInstallments DiscountInstallment[]
  iptuRecords          IptuRecord[]
  waterRecords         WaterRecord[]
  energyRecords        EnergyRecord[]
  annualReports        AnnualReport[]
  auditLogs            AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@index([endDate])
  @@index([dueDay])
}

model MonthlyObligation {
  id         String @id @default(cuid())
  contractId String

  /// Monthly competence in YYYY-MM format.
  competence String
  dueDate    DateTime

  rentStatus     ObligationStatus @default(PENDING)
  waterStatus    ObligationStatus @default(NOT_APPLICABLE)
  energyStatus   ObligationStatus @default(NOT_APPLICABLE)
  iptuStatus     ObligationStatus @default(NOT_APPLICABLE)
  transferStatus TransferStatus   @default(NOT_APPLICABLE)
  chargeStatus   ChargeStatus     @default(NONE)

  rentProofReceivedAt        DateTime?
  waterProofReceivedAt       DateTime?
  energyProofReceivedAt      DateTime?
  rentProofSentToOwnerAt     DateTime?
  discountProofSentToOwnerAt DateTime?

  contract Contract @relation(fields: [contractId], references: [id])

  paymentProofs        PaymentProof[]
  charge               Charge?
  transfer             Transfer?
  discountInstallments DiscountInstallment[]
  iptuInstallments     IptuInstallment[]
  waterRecord          WaterRecord?
  energyRecord         EnergyRecord?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, competence])
  @@index([contractId])
  @@index([competence])
  @@index([dueDate])
  @@index([rentStatus])
  @@index([transferStatus])
  @@index([chargeStatus])
}

model PaymentProof {
  id                  String              @id @default(cuid())
  contractId          String
  monthlyObligationId String?
  type                ProofType
  fileUrl             String?
  originalFileName    String?
  amount              Decimal?            @db.Decimal(12, 2)
  paidAt              DateTime?
  receivedAt          DateTime            @default(now())
  analysisStatus      ProofAnalysisStatus @default(NOT_ANALYZED)
  notes               String?

  contract          Contract           @relation(fields: [contractId], references: [id])
  monthlyObligation MonthlyObligation? @relation(fields: [monthlyObligationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([monthlyObligationId])
  @@index([type])
  @@index([analysisStatus])
}

model Charge {
  id                  String             @id @default(cuid())
  contractId          String
  monthlyObligationId String             @unique
  stage               ChargeStage
  status              ChargeRecordStatus @default(OPEN)
  lastMessageAt       DateTime?
  resolvedAt          DateTime?
  notes               String?

  contract          Contract          @relation(fields: [contractId], references: [id])
  monthlyObligation MonthlyObligation @relation(fields: [monthlyObligationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([stage])
  @@index([status])
}

model Transfer {
  id                  String @id @default(cuid())
  contractId          String
  monthlyObligationId String @unique
  ownerId             String

  grossRentAmount            Decimal              @db.Decimal(12, 2)
  administrationFeeAmount    Decimal              @default(0) @db.Decimal(12, 2)
  intermediationFeeAmount    Decimal              @default(0) @db.Decimal(12, 2)
  discountAmount             Decimal              @default(0) @db.Decimal(12, 2)
  netTransferAmount          Decimal              @db.Decimal(12, 2)
  isReleasedByGuarantee      Boolean              @default(false)
  guaranteeType              GuaranteeType?
  status                     TransferRecordStatus @default(PENDING)
  transferredAt              DateTime?
  rentProofSentToOwnerAt     DateTime?
  discountProofSentToOwnerAt DateTime?

  contract          Contract          @relation(fields: [contractId], references: [id])
  monthlyObligation MonthlyObligation @relation(fields: [monthlyObligationId], references: [id])
  owner             Owner             @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([ownerId])
  @@index([status])
}

model Discount {
  id                String         @id @default(cuid())
  contractId        String
  type              DiscountType
  description       String
  totalAmount       Decimal        @db.Decimal(12, 2)
  installmentCount  Int            @default(1)
  installmentAmount Decimal        @db.Decimal(12, 2)
  status            DiscountStatus @default(ACTIVE)
  notes             String?

  contract     Contract              @relation(fields: [contractId], references: [id])
  installments DiscountInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([status])
}

model DiscountInstallment {
  id                  String                    @id @default(cuid())
  discountId          String
  contractId          String
  monthlyObligationId String?
  installmentNumber   Int
  totalInstallments   Int
  amount              Decimal                   @db.Decimal(12, 2)
  status              DiscountInstallmentStatus @default(PENDING)
  appliedAt           DateTime?

  discount          Discount           @relation(fields: [discountId], references: [id])
  contract          Contract           @relation(fields: [contractId], references: [id])
  monthlyObligation MonthlyObligation? @relation(fields: [monthlyObligationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([discountId, installmentNumber])
  @@index([contractId])
  @@index([monthlyObligationId])
  @@index([status])
}

model IptuRecord {
  id               String             @id @default(cuid())
  contractId       String?
  propertyId       String
  year             Int
  type             IptuType
  responsibility   IptuResponsibility
  totalAmount      Decimal            @db.Decimal(12, 2)
  installmentCount Int                @default(1)
  status           IptuStatus         @default(PENDING)

  contract Contract? @relation(fields: [contractId], references: [id])
  property Property  @relation(fields: [propertyId], references: [id])

  installments IptuInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([propertyId])
  @@index([year])
  @@index([status])
}

model IptuInstallment {
  id                  String                @id @default(cuid())
  iptuRecordId        String
  monthlyObligationId String?
  installmentNumber   Int
  totalInstallments   Int
  amount              Decimal               @db.Decimal(12, 2)
  dueDate             DateTime
  status              IptuInstallmentStatus @default(PENDING)
  paidAt              DateTime?

  iptuRecord        IptuRecord         @relation(fields: [iptuRecordId], references: [id])
  monthlyObligation MonthlyObligation? @relation(fields: [monthlyObligationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([iptuRecordId, installmentNumber])
  @@index([monthlyObligationId])
  @@index([dueDate])
  @@index([status])
}

model WaterRecord {
  id                  String        @id @default(cuid())
  contractId          String
  monthlyObligationId String        @unique
  status              UtilityStatus @default(PENDING)
  proofReceivedAt     DateTime?
  amount              Decimal?      @db.Decimal(12, 2)
  notes               String?

  contract          Contract          @relation(fields: [contractId], references: [id])
  monthlyObligation MonthlyObligation @relation(fields: [monthlyObligationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([status])
}

model EnergyRecord {
  id                  String        @id @default(cuid())
  contractId          String
  monthlyObligationId String        @unique
  status              UtilityStatus @default(PENDING)
  proofReceivedAt     DateTime?
  amount              Decimal?      @db.Decimal(12, 2)
  notes               String?

  contract          Contract          @relation(fields: [contractId], references: [id])
  monthlyObligation MonthlyObligation @relation(fields: [monthlyObligationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([status])
}

model AnnualReport {
  id          String             @id @default(cuid())
  ownerId     String
  propertyId  String?
  contractId  String?
  year        Int
  status      AnnualReportStatus @default(NOT_GENERATED)
  generatedAt DateTime?
  sentAt      DateTime?
  fileUrl     String?
  notes       String?

  owner    Owner     @relation(fields: [ownerId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([propertyId])
  @@index([contractId])
  @@index([year])
  @@index([status])
}

model AuditLog {
  id         String  @id @default(cuid())
  userId     String?
  contractId String?
  entityType String
  entityId   String?
  action     String
  message    String?
  metadata   Json?

  user     User?     @relation(fields: [userId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([contractId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}
